# ─── Dodo Payments (REQUIRED for billing) ────────────────────────────────────
# Get your API key from: Dodo Dashboard → Developer → API Keys
DODO_PAYMENTS_API_KEY=sk_test_xxxxxxxxxxxxxxxx

# Get your webhook key from: Dodo Dashboard → Developer → Webhooks → Your Endpoint → Overview tab
DODO_PAYMENTS_WEBHOOK_KEY=whsec_xxxxxxxxxxxxxxxx

# Use "test_mode" while testing, switch to "live_mode" when you go live
DODO_PAYMENTS_ENVIRONMENT=test_mode

# ─── Dodo Product IDs (OPTIONAL - auto-provisioned if not set) ────────────────
# Products will be automatically created in Dodo if these are not set.
# You can pre-create them using the setup script for more control:
#   DODO_PAYMENTS_API_KEY=sk_test_xxx DODO_PAYMENTS_ENVIRONMENT=test_mode npx tsx scripts/setup-dodo-products.ts
# Then paste the output product IDs here:

# Subscription Plans (auto-created if empty)
DODO_PRODUCT_EXPLORER=
DODO_PRODUCT_STARTER=
DODO_PRODUCT_BUSINESS=
DODO_PRODUCT_PROFESSIONAL=
DODO_PRODUCT_ENTERPRISE=

# Permanent Credit Packs (auto-created if empty)
DODO_PRODUCT_PERM_50K=
DODO_PRODUCT_PERM_100K=
DODO_PRODUCT_PERM_300K=
DODO_PRODUCT_PERM_600K=
DODO_PRODUCT_PERM_1M=
DODO_PRODUCT_PERM_5M=

# ─── ATAI Ecosystem Internal API (REQUIRED for WEB ↔ MirrorSite integration) ─
# A shared secret used by the VettCode WEB app (atai.ink) to fetch project
# data server-to-server. Generate with: openssl rand -hex 32
# This key must match ATAI_INTERNAL_KEY in the WEB app's .env
ATAI_INTERNAL_KEY=your_shared_internal_key_here_min_32_chars

# ─── OpenRouter (REQUIRED for the AI build pipeline + Atai Runtime API) ─────
# Server-side only — never exposed to clients or generated applications.
# Used by two SEPARATE flows: Atai's internal build pipeline, and the customer
# runtime adapter (lib/runtime/router/adapters/openrouter).
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: default OpenRouter model for runtime chat requests that do not
# specify one (e.g. openai/gpt-5.2). Leave empty to require callers to send a model.
OPENROUTER_DEFAULT_MODEL=
# Optional: override ONLY for integration tests. Never set in production.
OPENROUTER_BASE_URL=
# Optional: provider request timeout in ms (default 60000, max 300000).
OPENROUTER_TIMEOUT_MS=

# ─── Onboarding (OPTIONAL) ───────────────────────────────────────────────────
# URL of the intro video shown on Step 4 of the onboarding dialog.
# Use a YouTube embed URL: https://www.youtube.com/embed/YOUR_VIDEO_ID
# or a Vimeo embed URL:    https://player.vimeo.com/video/YOUR_VIDEO_ID
# Leave blank to show a placeholder until the video is ready.
NEXT_PUBLIC_ONBOARDING_VIDEO_URL=

# ─── ElevenLabs (OPTIONAL — voice synthesis for generated apps) ──────────────
# Get your API key from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Optional: default voice ID (callers may override per request).
ELEVENLABS_DEFAULT_VOICE_ID=
# Optional: default model (eleven_multilingual_v2, eleven_flash_v2_5, eleven_turbo_v2_5).
ELEVENLABS_DEFAULT_MODEL=
# Optional: request timeout in ms (default 60000).
ELEVENLABS_TIMEOUT_MS=

# ─── Firecrawl (OPTIONAL — web search/scrape for generated apps) ─────────────
# Get your API key from: https://firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=
# Optional: request timeout in ms (default 30000).
FIRECRAWL_TIMEOUT_MS=

# ─── Resend (OPTIONAL — transactional email for generated apps) ──────────────
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=
# Optional: from address (required for sending).
RESEND_FROM_ADDRESS=
# Optional: request timeout in ms (default 30000).
RESEND_TIMEOUT_MS=

# ─── Twilio (OPTIONAL — SMS/WhatsApp for generated apps) ─────────────────────
# Get credentials from: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional: default phone number for outbound SMS.
TWILIO_PHONE_NUMBER=
# Optional: WhatsApp sender phone number.
TWILIO_WHATSAPP_NUMBER=
# Optional: request timeout in ms (default 30000).
TWILIO_TIMEOUT_MS=

# ─── Firebase (OPTIONAL — push notifications for generated apps) ─────────────
# Firebase Admin SDK service account credentials.
# Create at: https://console.firebase.google.com → Project Settings → Service Accounts
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
# Optional: request timeout in ms (default 30000).
FIREBASE_TIMEOUT_MS=

# ─── Mapbox (OPTIONAL — maps/geolocation for generated apps) ─────────────────
# Get your access token from: https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=
# Optional: request timeout in ms (default 30000).
MAPBOX_TIMEOUT_MS=

# ─── Cal.com (OPTIONAL — calendar/scheduling for generated apps) ──────────────
# Get your API key from: https://cal.com/settings/developer
CALCOM_API_KEY=
# Optional: request timeout in ms (default 30000).
CALCOM_TIMEOUT_MS=

# ─── Cloudflare (OPTIONAL — vector database for generated apps) ──────────────
# Get credentials from: https://dash.cloudflare.com → Workers & Pages → Vectorize
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_VECTORIZE_INDEX_ID=
# Optional: request timeout in ms (default 30000).
CLOUDFLARE_TIMEOUT_MS=

# ─── Totalum (OPTIONAL — runtime database for generated apps) ────────────────
# Reuses the existing TOTALUM_API_KEY from the build system (no duplicate needed).
# If you want a separate runtime key, set TOTALUM_RUNTIME_BASE_URL.
TOTALUM_API_KEY=
# Optional: override the Totalum API base URL for runtime.
TOTALUM_RUNTIME_BASE_URL=
# Optional: request timeout in ms (default 30000).
TOTALUM_RUNTIME_TIMEOUT_MS=

# ─── Dodo Payments Runtime (OPTIONAL — payments for generated apps) ──────────
# Separate from the Atai platform billing Dodo credentials above.
# Get your API key from: https://dodopayments.com/dashboard → Developer → API Keys
DODO_PAYMENTS_API_KEY=
# Optional: request timeout in ms (default 30000).
DODO_PAYMENTS_TIMEOUT_MS=

# ─── Runtime capacity (OPTIONAL) ────────────────────────────────────────────
# Mongo connection pool per Node process (default 50, min 10, max 200).
MONGODB_MAX_POOL_SIZE=
# How long to wait for a free pool slot before failing (default 10000 ms).
MONGODB_WAIT_QUEUE_TIMEOUT_MS=
# Max concurrent authenticated runtime requests per Node process (default 32).
RUNTIME_MAX_IN_FLIGHT=
